<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="EnableLogging" value="true" />
		<add key="LogFilePath" value="C:\Logs\service_log.txt" />
	</appSettings>

	<system.serviceModel>
		<serviceHostingEnvironment multipleSiteBindingsEnabled="true" />

		<services>
			<service name="FileProcessingApp.FileProcessingService" behaviorConfiguration="ServiceBehavior">
				<host>
					<baseAddresses>
						<add baseAddress="http://localhost:8500/FileProcessingApp/" />
					</baseAddresses>
				</host>
				<endpoint
				  address=""
				  binding="webHttpBinding"
				  contract="FileProcessingApp.IFileProcessingService"
				  behaviorConfiguration="webBehavior" />
				<endpoint
				  address="mex"
				  binding="mexHttpBinding"
				  contract="IMetadataExchange" />
			</service>
		</services>

		<behaviors>
			<endpointBehaviors>
				<behavior name="webBehavior">
					<webHttp />
				</behavior>
			</endpointBehaviors>

			<serviceBehaviors>
				<behavior name="ServiceBehavior">
					<serviceMetadata httpGetEnabled="true" />
					<serviceDebug includeExceptionDetailInFaults="true" />
				</behavior>
			</serviceBehaviors>
		</behaviors>
	</system.serviceModel>
</configuration>
